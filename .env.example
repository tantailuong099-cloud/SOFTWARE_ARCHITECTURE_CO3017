# 1. Chế độ kích hoạt (ACTIVE_ENV: AUTO | LOCAL | TUNNEL | LAN | PROD)
ACTIVE_ENV=AUTO

# 2. Danh sách các API Endpoint:
API_URL_LOCAL=http://localhost:3000/api
API_URL_TUNNEL=https://<your-tunnel-id>-3000.asse.devtunnels.ms/api
API_URL_LAN=http://192.168.1.10:3000/api
API_URL_PROD=https://api.tmc-attendance.example.com/api
